# Your permanent Decart secret key. Server-side only — NEVER sent to the browser.
# Get one from your Decart dashboard: https://platform.decart.ai
DECART_API_KEY=

# Port Render (or your local machine) should bind to.
PORT=10000

# Comma-separated list of origins allowed to call POST /token.
# Leave blank to allow the same origin the server itself is serving on.
# Example: https://yourapp.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=
